# ================================================================
# Brite Spark — Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in values as needed.
# The .env file is git-ignored and will never be committed.
#
#   cp .env.example .env
#
# Every value below has a sensible default in src/config.py.
# The system works fully offline with no API key set (see DECISIONS.md).
# ================================================================

# --- LLM Provider (Optional) --------------------------------------------
# The system works fully without an LLM: with no key set, answers are
# built directly from verified evidence text (see DECISIONS.md).
# Setting LLM_API_KEY enables Groq LLM answer phrasing.
# Output still passes strict citation validation before display.
#
# Default provider is Groq's OpenAI-compatible chat completions API.
# Get a free key at: https://console.groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_ENABLED=true

# Alternative Groq naming (supported interchangeably)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Corpus Paths --------------------------------------------------------
POLICY_MANUAL_PATH=data/policy.md
AMENDMENT_PATH=data/Amendment No. 2026-01.md

# --- Retrieval Configuration ---------------------------------------------
RETRIEVAL_TOP_K=5

# --- Evidence Sufficiency Thresholds --------------------------------------
MIN_RELEVANCE_SCORE=0.25
MIN_SUPPORT_SCORE=0.35

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
