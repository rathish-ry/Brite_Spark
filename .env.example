# ================================================================
# Brite Spark — Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and will never be committed.
#
#   cp .env.example .env
#
# ================================================================
# Groq API Configuration (OPTIONAL)
# ----------------------------------------------------------------
# Without this key the system runs fully offline using the
# deterministic fallback engine. All 20 benchmark questions
# pass and all 68 unit tests pass with no key set.
#
# Get a free key at: https://console.groq.com
# ================================================================

GROQ_API_KEY=your_groq_api_key_here

# Model to use for answer synthesis (default shown below)
# Available Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
